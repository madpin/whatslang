# =====================================================================
#  Whatslang configuration
#  Copy this file to .env and fill in your values.
# =====================================================================

# Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development          # "development" | "production"
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# Single-user dashboard auth ----------------------------------------
# Leave BOTH empty to disable authentication entirely (e.g. when
# running on a private network behind another auth proxy).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Optional: secret used to sign session cookies. Auto-generated when
# omitted, but in that case sessions reset on every server restart.
SESSION_SECRET=

# WhatsApp gateway ---------------------------------------------------
# Compatible with whatsapp-mcp / wha-mcp REST APIs.
WHATSAPP_BASE_URL=http://localhost:8081
WHATSAPP_API_USER=
WHATSAPP_API_PASSWORD=
# Optional sender JID used to detect "self" messages. Leave empty to
# auto-detect from outgoing messages.
DEVICE_ID=

# LLM (OpenAI / LiteLLM compatible) ---------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Falls back to OPENAI_MODEL when empty.
OPENAI_VISION_MODEL=
OPENAI_AUDIO_MODEL=whisper-1

# Bot runtime --------------------------------------------------------
POLL_INTERVAL=5                  # seconds between WhatsApp polls
DB_PATH=./data/messages.db       # use /data/messages.db inside Docker

# Backwards compatibility -------------------------------------------
# If set, this chat JID is auto-seeded into the chats table on boot.
CHAT_JID=
