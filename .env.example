# =====================================================================
#  Whatslang configuration
#  Copy this file to .env and fill in your values.
# =====================================================================

# Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development          # "development" | "production"
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# Single-user dashboard auth ----------------------------------------
# DASHBOARD_PASSWORD=""  disables auth (the API becomes open). The
# service WILL REFUSE TO START in ENVIRONMENT=production unless a
# password is set, and warns loudly in development. Always set one
# before exposing the service to anything beyond localhost.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-please-pick-a-long-random-string

# Required in production. Sign session cookies with at least 32 random
# bytes. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# When empty in development, a per-process random key is used and
# sessions reset on every restart (and don't survive a multi-instance
# deploy).
SESSION_SECRET=

# Comma-separated list of origins allowed to call the API from a
# browser. Leave empty or set to '*' for development only — the service
# refuses to start in production with a wildcard.
ALLOWED_ORIGINS=*

# WhatsApp gateway ---------------------------------------------------
# Compatible with whatsapp-mcp / wha-mcp REST APIs.
WHATSAPP_BASE_URL=http://localhost:8081
WHATSAPP_API_USER=
WHATSAPP_API_PASSWORD=
# Default device. This is the GoWA device id (X-Device-Id) used for
# un-scoped calls and as the default account bots read from. It doubles
# as the JID used to detect "self" messages. Leave empty for a
# single-device gateway with no scoping.
DEVICE_ID=
# Extra devices for a GoWA v8 multi-device gateway (one instance, many
# accounts). JSON array; each entry needs an "id" (the X-Device-Id
# value — a label or a JID), plus optional "label" (shown in the UI)
# and "jid" (the account's own JID, for self-message detection; defaults
# to "id" when it already looks like a JID). Per-bot read/send routing
# is configured from each chat's bot settings in the dashboard.
# Example:
#   DEVICES=[{"id":"628111@s.whatsapp.net","label":"Personal"},{"id":"628222@s.whatsapp.net","label":"Work"}]
DEVICES=

# LLM (OpenAI / LiteLLM compatible) ---------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Falls back to OPENAI_MODEL when empty.
OPENAI_VISION_MODEL=
OPENAI_AUDIO_MODEL=whisper-1

# Bot runtime --------------------------------------------------------
POLL_INTERVAL=5                  # seconds between WhatsApp polls
DB_PATH=./data/messages.db       # use /data/messages.db inside Docker

# Backwards compatibility -------------------------------------------
# If set, this chat JID is auto-seeded into the chats table on boot.
CHAT_JID=
